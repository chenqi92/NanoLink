# Normalize text files by default
* text=auto

# Repository config files should stay LF
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Source files should stay LF across platforms
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cs text eol=lf
*.css text eol=lf
*.go text eol=lf
*.graphql text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.html text eol=lf
*.java text eol=lf
*.js text eol=lf
*.json text eol=lf
*.jsx text eol=lf
*.md text eol=lf
*.proto text eol=lf
*.py text eol=lf
*.rb text eol=lf
*.rs text eol=lf
*.scss text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.svg text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Windows-specific scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Common binary assets
*.dll binary
*.eot binary
*.exe binary
*.gif binary
*.gz binary
*.ico binary
*.jar binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.so binary
*.tar binary
*.tgz binary
*.ttf binary
*.woff binary
*.woff2 binary
*.zip binary
