[Unit]
Description=NanoOps Monitoring Agent
Documentation=https://github.com/chenqi92/nanolink
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/nanolink-agent -c /etc/nanolink/nanolink.yaml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
RuntimeDirectory=nanolink
RuntimeDirectoryMode=0750
Environment=NANOLINK_RUNTIME_DIR=/run/nanolink
ExecStartPre=/usr/bin/mkdir -p /run/nanolink
ExecStartPre=/usr/bin/chmod 0750 /run/nanolink

# Security hardening
NoNewPrivileges=true
ProtectSystem=false
ProtectHome=true
PrivateTmp=true
# Optional deployment roots are writable only when they exist. Deployment is
# still disabled by default in nanolink.yaml and restricted by allowed_roots.
# Use the legacy directive names because they are also understood by modern
# systemd and keep package/config operations working on systemd 219 hosts.
ReadWriteDirectories=/run/nanolink /var/log/nanolink /usr /etc -/opt/nanolink/apps -/var/www/nanolink -/var/lib/nanolink/builds
ReadOnlyDirectories=/etc/nanolink

# Resource limits
# Package installation and archive staging run in the Agent cgroup. Leave
# enough burst capacity so management work cannot starve gRPC heartbeats.
MemoryLimit=512M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
