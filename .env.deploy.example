# NanoOps Server deployment settings.
# Copy this file to .env.deploy and edit it locally. Never put passwords,
# private keys, JWT secrets, or production application secrets in this file.

DEPLOY_SSH_HOST=ubuntu@YOUR_SERVER_IP
DEPLOY_SSH_PORT=22
DEPLOY_REMOTE_UPLOAD_DIR=/home/ubuntu
DEPLOY_REMOTE_BUILD_ROOT=/home/nanolink
DEPLOY_COMPOSE_DIR=/home/nanolink/server
DEPLOY_COMPOSE_SERVICE=nanolink-server
DEPLOY_IMAGE_REPOSITORY=nanolink-server
DEPLOY_PUBLIC_URL=https://server.example.com
DEPLOY_EXPECTED_AGENT_COUNT=0
DEPLOY_HEALTH_TIMEOUT_SECONDS=120

# Host-side HTTP port published by the existing container/Compose service.
# The default preserves the repository's historical 8080 mapping. Override it
# only in the ignored local .env.deploy file when the host uses another port.
DEPLOY_HOST_HTTP_PORT=8080

# Optional explicit loopback health endpoint. Leave empty to derive
# http://127.0.0.1:DEPLOY_HOST_HTTP_PORT/api/health. For safety, only that
# loopback shape is accepted and its port must match DEPLOY_HOST_HTTP_PORT.
DEPLOY_LOCAL_HEALTH_URL=

# Safe default: require a clean Git working tree. Set this to true only when
# this machine intentionally publishes uncommitted Server/Web changes.
DEPLOY_ALLOW_DIRTY=false

# Optional path to a dedicated SSH private key. Leave empty to use the normal
# OpenSSH agent/default key lookup. The key file itself must never be committed.
DEPLOY_SSH_IDENTITY_FILE=
