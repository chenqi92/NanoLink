# /data/nanoops/server.env
# The installer creates this file as root:root mode 0600. Do not commit or share
# the real file. Values below are examples only.

NANOLINK_SERVER_HTTP_PORT="18080"
NANOLINK_SERVER_WS_PORT="19100"
NANOLINK_SERVER_GRPC_PORT="39100"
NANOLINK_JWT_EXPIRE_HOUR="12"

NANOLINK_JWT_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"
NANOLINK_ADMIN_USERNAME="nanoops_admin"
NANOLINK_ADMIN_PASSWORD="REPLACE_WITH_A_LONG_RANDOM_PASSWORD"

# Set this after DNS/TLS is ready. Use an HTTPS origin without a path.
# NANOLINK_EXTERNAL_URL="https://nanoops.example.com"

