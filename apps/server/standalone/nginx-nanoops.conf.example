# Put this file in /etc/nginx/conf.d/nanoops.conf (or the distribution's
# sites-available/sites-enabled directories), replace the domain and port, then
# obtain a certificate with: certbot --nginx -d nanoops.example.com

limit_req_zone $binary_remote_addr zone=nanoops_auth:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=nanoops_per_ip:10m;

map $http_upgrade $nanoops_connection_upgrade {
    default upgrade;
    ''      close;
}

upstream nanoops_backend {
    server 127.0.0.1:18080;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name nanoops.example.com;

    client_max_body_size 530m;

    location ~ ^/api/auth/(login|register|pairing)$ {
        limit_req zone=nanoops_auth burst=10 nodelay;
        proxy_pass http://nanoops_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        limit_conn nanoops_per_ip 30;
        proxy_pass http://nanoops_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $nanoops_connection_upgrade;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}

