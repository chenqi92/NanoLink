#!/bin/sh
#
# Git pre-commit hook for NanoLink
# - Removes BOM characters from staged files
# - Checks code format and runs tests
#
# Installation:
#   - Run: ./scripts/install-hooks.sh
#   - Or manually: cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# Skip hook: git commit --no-verify
#

set -e

# Get the root directory of the repository
ROOT_DIR="$(git rev-parse --show-toplevel)"

echo "🔍 Running pre-commit checks..."
echo ""

# ============================================================
# Step 1: BOM Removal
# ============================================================
case "$(uname -s)" in
    CYGWIN*|MINGW*|MSYS*)
        # Windows (Git Bash, MSYS, Cygwin)
        if command -v powershell.exe &> /dev/null; then
            echo "📝 Running BOM removal (Windows PowerShell)..."
            powershell.exe -ExecutionPolicy Bypass -File "$ROOT_DIR/scripts/remove-bom.ps1" || true
        fi
        ;;
    *)
        # Linux/macOS
        if [ -f "$ROOT_DIR/scripts/remove-bom.sh" ]; then
            echo "📝 Running BOM removal (Unix)..."
            bash "$ROOT_DIR/scripts/remove-bom.sh" || true
        fi
        ;;
esac

# Check if any files were modified by the BOM removal
MODIFIED=$(git diff --name-only)
if [ -n "$MODIFIED" ]; then
    echo ""
    echo "The following files were modified by BOM removal:"
    echo "$MODIFIED"
    echo ""
    echo "These changes have been auto-staged for your commit."
    git add $MODIFIED
fi

# ============================================================
# Step 2: Agent Checks (if agent files changed)
# ============================================================
if git diff --cached --name-only | grep -q "^agent/"; then
    echo ""
    echo "🦀 Checking Agent..."
    cd "$ROOT_DIR/agent"

    echo "  → Checking format..."
    if ! cargo fmt --all -- --check; then
        echo ""
        echo "❌ Format check failed!"
        echo "   Run 'cd agent && cargo fmt --all' to fix."
        exit 1
    fi

    echo "  → Running clippy..."
    if ! cargo clippy --quiet -- -D warnings \
        -A clippy::large_enum_variant \
        -A clippy::field_reassign_with_default \
        -A clippy::manual_clamp \
        -A clippy::lines_filter_map_ok \
        -A clippy::empty_line_after_doc_comments \
        -A clippy::collapsible_if \
        -A clippy::too_many_arguments \
        -A clippy::type_complexity \
        -A clippy::uninlined_format_args \
        -A clippy::needless_return \
        -A clippy::redundant_field_names \
        -A clippy::single_match \
        -A dead_code \
        -A unused_imports \
        -A unused_variables \
        -A unused_assignments \
        -A unused_mut 2>/dev/null; then
        echo ""
        echo "❌ Clippy check failed!"
        exit 1
    fi

    # Tests require protoc - skip if not available
    if command -v protoc &> /dev/null; then
        echo "  → Running tests..."
        if ! cargo test --quiet 2>/dev/null; then
            echo ""
            echo "❌ Tests failed!"
            exit 1
        fi
    else
        echo "  → Skipping tests (protoc not installed)"
    fi

    echo "  ✅ Agent checks passed"
fi

# ============================================================
# Step 3: Python SDK Checks (if python files changed)
# ============================================================
if git diff --cached --name-only | grep -q "^sdk/python/"; then
    echo ""
    echo "🐍 Checking Python SDK..."
    cd "$ROOT_DIR/sdk/python"

    if command -v black &> /dev/null; then
        echo "  → Checking format with black..."
        if ! black --check . 2>/dev/null; then
            echo ""
            echo "❌ Python format check failed!"
            echo "   Run 'cd sdk/python && black .' to fix."
            exit 1
        fi
    fi

    echo "  ✅ Python SDK checks passed"
fi

# ============================================================
# Step 4: Go SDK Checks (if go files changed)
# ============================================================
if git diff --cached --name-only | grep -q "^sdk/go/"; then
    echo ""
    echo "🔷 Checking Go SDK..."
    cd "$ROOT_DIR/sdk/go"

    if command -v go &> /dev/null; then
        echo "  → Running go build..."
        if ! go build ./... 2>/dev/null; then
            echo ""
            echo "❌ Go build failed!"
            exit 1
        fi
    fi

    echo "  ✅ Go SDK checks passed"
fi

echo ""
echo "✅ All pre-commit checks passed!"
exit 0
